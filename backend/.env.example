# ---- Server ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://expense_user:your_db_password@localhost:5432/expense_tracker
DB_POOL_MAX=10

TEST_DATABASE_URL=postgresql://expense_user:your_db_password@localhost:5432/expense_tracker_test

# ---- JWT ----
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ---- CORS / Frontend ----
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---- Cookies ----
COOKIE_SECURE=false

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Email (SMTP via Brevo) - used from Phase 3 and Phase 3B ----
# Brevo: SMTP & API -> SMTP. SMTP_PASS is the SMTP key, NOT your account password.
# EMAIL_FROM must use a sender verified in Brevo (Senders, Domains & Dedicated IPs).
# Leave SMTP_HOST as smtp.example.com to only log emails in the terminal.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM="Expense Tracker <your_verified_sender@example.com>"

# ---- Logging ----
LOG_LEVEL=debug